# ============================================
# INSTAGRAM GRAPH API (Opcional)
# ============================================
# Para conectar tu cuenta real de Instagram:
# 1. Creá una app en https://developers.facebook.com
# 2. Configurá Instagram Basic Display o Graph API
# 3. Obtené tu token de acceso
# 4. Completá las variables de abajo

INSTAGRAM_ACCESS_TOKEN=tu_token_aqui
INSTAGRAM_USER_ID=tu_user_id_aqui
FACEBOOK_APP_ID=tu_app_id_aqui
FACEBOOK_APP_SECRET=tu_app_secret_aqui

# ============================================
# IA - OPENAI (Opcional)
# ============================================
# Para activar la generación real de contenido con IA:
# 1. Creá una cuenta en https://platform.openai.com
# 2. Generá una API Key
# 3. Pegala abajo

OPENAI_API_KEY=tu_api_key_aqui

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
